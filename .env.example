KEMAL_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://postgres:postgres@postgres:5432/kemalcr_development
REDIS_URL=redis://redis:6379/0
AUTH_LOGIN_THROTTLE_LIMIT=5
AUTH_REFRESH_THROTTLE_LIMIT=10
AUTH_THROTTLE_WINDOW_SECONDS=60
APP_NAME=kemalcr_starter
APP_VERSION=0.1.0
APP_BUILD_TIME=unknown
APP_GIT_SHA=unknown
ALWAYS_RESCUE=false
OPENAPI_PATH=openapi/openapi.yaml
MIGRATIONS_PATH=db/migrations
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_SECRET=change-me-in-real-environments
PASSWORD_PEPPER=change-me-in-real-environments
BCRYPT_COST=10
EVENT_POLL_INTERVAL_MS=100
EVENT_BATCH_SIZE=50
EVENT_MAX_RETRIES=5
TEST_DATABASE_URL=postgres://postgres:postgres@postgres:5432/kemalcr_development
TEST_REDIS_URL=redis://redis:6379/0
PGPASSWORD=postgres